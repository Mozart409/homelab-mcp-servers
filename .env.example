# Proxmox Backup Server MCP (pbsmcp-server)
# Copy this file to `.env` and fill in your values:  cp .env.example .env

# PBS base URL. Scheme defaults to https:// and port to 8007 when omitted.
# Examples: https://pbs.lan:8007  |  pbs.lan:8007  |  pbs.lan
PBS_HOST=https://pbs.lan:8007

# API token, formatted `user@realm!tokenname:secret`.
# Create one in the PBS UI (Configuration -> Access Control -> API Tokens), or:
#   proxmox-backup-manager user generate-token user@pbs mytoken
# then join the returned token id and secret value with a colon (`:`).
#
# The token also needs ACLs, or PBS returns empty lists ([]) and 403 errors
# instead of data. Grant the TOKEN id (not just its user -- tokens default to
# privilege separation and do NOT inherit user perms), with Propagate enabled:
#   proxmox-backup-manager acl update /datastore DatastoreAudit --auth-id 'monitor@pbs!mcp'
#   proxmox-backup-manager acl update /system    Sys.Audit      --auth-id 'monitor@pbs!mcp'
# /datastore -> datastore/snapshot/group/GC tools; /system -> node_status + list_tasks.
PBS_API_KEY=monitor@pbs!mcp:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: node name used for /nodes/{node}/... endpoints (default: localhost)
#PBS_NODE=localhost

# Optional: accept self-signed / invalid TLS certificates (set to 1 or true)
#PBS_INSECURE=0

# Optional: address to bind the streamable-HTTP MCP server (default: 127.0.0.1:8080)
# The MCP endpoint is served at http://<bind>/mcp
#PBS_BIND=127.0.0.1:8080

# Optional: comma-separated allowed Host header values. Defaults to loopback only
# (DNS-rebinding protection). Set this when serving on a hostname, e.g. behind
# Tailscale or a reverse proxy.
#PBS_ALLOWED_HOSTS=pbs-mcp.example.ts.net,localhost,127.0.0.1


# ----------------------------------------------------------------------------
# Postgres MCP (pgmcp-server)
# ----------------------------------------------------------------------------

# Credentials for the bundled `postgres` container in compose.yaml. POSTGRES_PASSWORD
# is required (compose errors out if unset); the user/db default to `pgmcp`.
POSTGRES_USER=pgmcp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pgmcp
# Optional: container timezone (default: UTC).
#TZ=UTC

# Connection string the MCP server uses. `PG_DATABASE_URL` takes precedence over
# `DATABASE_URL`. Inside compose, the host is the `postgres` service name; from
# your host machine it is 127.0.0.1 (the port is published loopback-only).
#   compose:    postgres://pgmcp:change-me@postgres:5432/pgmcp
#   local host: postgres://pgmcp:change-me@127.0.0.1:5432/pgmcp
PG_DATABASE_URL=postgres://pgmcp:change-me@127.0.0.1:5432/pgmcp

# Optional: address to bind the streamable-HTTP MCP server (default 127.0.0.1:8081).
# The MCP endpoint is served at http://<bind>/mcp
#PG_BIND=127.0.0.1:8081

# Optional: comma-separated allowed Host header values. Defaults to loopback only
# (DNS-rebinding protection). Set this when serving on a hostname.
#PG_ALLOWED_HOSTS=pg-mcp.example.ts.net,localhost,127.0.0.1

# Optional safety/limits:
#   PG_MAX_CONNECTIONS       connection pool size            (default 5)
#   PG_STATEMENT_TIMEOUT_MS  per-query timeout in ms         (default 5000)
#   PG_MAX_ROWS              max rows returned per tool call (default 1000)
#PG_MAX_CONNECTIONS=5
#PG_STATEMENT_TIMEOUT_MS=5000
#PG_MAX_ROWS=1000

# Running several Postgres databases (one pgmcp-server each)? The primary
# instance uses POSTGRES_* above. Each extra instance needs its own credentials;
# compose.yaml has a commented postgres2/pgmcp2 pair — set matching PG2_* here.
#PG2_USER=pgmcp
#PG2_PASSWORD=change-me-too
#PG2_DB=pgmcp


# ----------------------------------------------------------------------------
# Prometheus MCP (prommcp-server)
# ----------------------------------------------------------------------------

# Prometheus base URL. Scheme defaults to http:// and port to 9090 when omitted.
# Examples: http://prometheus.lan:9090  |  prometheus.lan:9090  |  prometheus.lan
PROM_HOST=http://prometheus.lan:9090

# Optional: bearer token, sent as `Authorization: Bearer <token>`. Set this only
# when Prometheus sits behind an authenticating reverse proxy.
#PROM_TOKEN=

# Optional: accept self-signed / invalid TLS certificates (set to 1 or true)
#PROM_INSECURE=0

# Optional: address to bind the streamable-HTTP MCP server (default 127.0.0.1:8082).
# The MCP endpoint is served at http://<bind>/mcp
#PROM_BIND=127.0.0.1:8082

# Optional: comma-separated allowed Host header values. Defaults to loopback only
# (DNS-rebinding protection). Set this when serving on a hostname.
#PROM_ALLOWED_HOSTS=prom-mcp.example.ts.net,localhost,127.0.0.1


# ----------------------------------------------------------------------------
# Loki MCP (lokimcp-server)
# ----------------------------------------------------------------------------

# Loki base URL. Scheme defaults to http:// and port to 3100 when omitted.
# Examples: http://loki.lan:3100  |  loki.lan:3100  |  loki.lan
LOKI_HOST=http://loki.lan:3100

# Optional: bearer token, sent as `Authorization: Bearer <token>` (e.g. behind an
# authenticating reverse proxy).
#LOKI_TOKEN=

# Optional: tenant ID, sent as the `X-Scope-OrgID` header. Required when Loki runs
# in multi-tenant mode; omit for a single-tenant instance.
#LOKI_ORG_ID=

# Optional: accept self-signed / invalid TLS certificates (set to 1 or true)
#LOKI_INSECURE=0

# Optional: address to bind the streamable-HTTP MCP server (default 127.0.0.1:8083).
# The MCP endpoint is served at http://<bind>/mcp
#LOKI_BIND=127.0.0.1:8083

# Optional: comma-separated allowed Host header values. Defaults to loopback only
# (DNS-rebinding protection). Set this when serving on a hostname.
#LOKI_ALLOWED_HOSTS=loki-mcp.example.ts.net,localhost,127.0.0.1


# ----------------------------------------------------------------------------
# Home Assistant MCP (hamcp-server)
# ----------------------------------------------------------------------------

# Home Assistant instance URL. Scheme defaults to http:// and port to 8123
# when omitted. Examples: http://homeassistant.local:8123  |  homeassistant.local:8123
HA_HOST=http://homeassistant.local:8123

# Long-lived access token. Create one in the HA UI
# (Profile -> Long-Lived Access Tokens -> Create Token).
HA_TOKEN=your_long_lived_access_token

# Optional: accept self-signed / invalid TLS certificates (set to 1 or true)
#HA_INSECURE=0

# Optional: address to bind the streamable-HTTP MCP server (default 127.0.0.1:8084).
# The MCP endpoint is served at http://<bind>/mcp
#HA_BIND=127.0.0.1:8084

# Optional: comma-separated allowed Host header values. Defaults to loopback only
# (DNS-rebinding protection). Set this when serving on a hostname.
#HA_ALLOWED_HOSTS=ha-mcp.example.ts.net,localhost,127.0.0.1


# ----------------------------------------------------------------------------
# Woodpecker CI MCP (wpmcp-server)
# ----------------------------------------------------------------------------

# Woodpecker CI instance URL. Scheme defaults to https:// when omitted.
# No port is appended by default; use 443 implicitly for the standard HTTPS port.
# Examples: https://ci.homelab.local  |  ci.homelab.local:8000  |  ci.homelab.local
WP_HOST=https://ci.homelab.local

# Personal access token. Create one in the Woodpecker UI: user profile page →
# Personal Access Tokens → Create Token. Sent as `Authorization: Bearer <token>`.
# This is required; every endpoint needs it, so a missing token just yields
# 401s on every tool call.
WP_TOKEN=your_personal_access_token_here

# Optional: accept untrusted TLS certificates (set to 1 or true). You usually do
# NOT need this: certificates are verified against the *host's* trust store, so an
# instance behind an internal CA validates normally as long as that CA is installed
# on this machine. Use it only for a genuinely untrusted cert.
#WP_INSECURE=0

# Optional: address to bind the streamable-HTTP MCP server (default 127.0.0.1:8085).
# The MCP endpoint is served at http://<bind>/mcp
#WP_BIND=127.0.0.1:8085

# Optional: comma-separated allowed Host header values. Defaults to loopback only
# (DNS-rebinding protection). Set this when serving on a hostname.
#WP_ALLOWED_HOSTS=wp-mcp.example.ts.net,localhost,127.0.0.1

# Optional: maximum number of log entries returned from step_logs (default 500).
# If set to 0, uses the default 500 (0 is treated as a safety default). Use this
# to cap very large step logs and avoid overwhelming responses.
#WP_MAX_LOG_LINES=500

# Note: The WP_ prefix (not WOODPECKER_) is intentional. Woodpecker CI injects
# WOODPECKER_* environment variables into every pipeline step as built-in
# context, so a WOODPECKER_* config prefix would collide whenever this server
# (or its tests) runs inside a Woodpecker pipeline.


# ----------------------------------------------------------------------------
# Alertmanager MCP (alertmanagermcp-server, port 8086)
# ----------------------------------------------------------------------------

# Alertmanager base URL. Scheme defaults to http:// and port to 9093 when omitted.
# Examples: http://alertmanager.lan:9093  |  alertmanager.lan:9093  |  alertmanager.lan
ALERTMANAGER_HOST=http://alertmanager.lan:9093

# Optional: bearer token, sent as `Authorization: Bearer <token>` (e.g. behind an
# authenticating reverse proxy).
#ALERTMANAGER_TOKEN=

# Optional: accept self-signed / invalid TLS certificates (set to 1 or true)
#ALERTMANAGER_INSECURE=false

# Optional: address to bind the streamable-HTTP MCP server (default 127.0.0.1:8086).
# The MCP endpoint is served at http://<bind>/mcp
#ALERTMANAGER_BIND=127.0.0.1:8086

# Optional: comma-separated allowed Host header values. Defaults to loopback only
# (DNS-rebinding protection). Set this when serving on a hostname.
#ALERTMANAGER_ALLOWED_HOSTS=alertmanager-mcp.example.ts.net,localhost,127.0.0.1

# Registers create_silence/expire_silence. Leave unset for a read-only server.
#ALERTMANAGER_ALLOW_SILENCE=false


# ----------------------------------------------------------------------------
# Tempo MCP (tempomcp-server, port 8092)
# ----------------------------------------------------------------------------

# Tempo base URL. Scheme defaults to http:// and port to 3200 when omitted.
# Examples: https://tempo.homelab.local  |  tempo.lan:3200  |  tempo.lan
TEMPO_HOST=http://tempo.lan:3200

# Optional: bearer token, sent as `Authorization: Bearer <token>` (e.g. behind an
# authenticating reverse proxy).
#TEMPO_TOKEN=

# Optional: tenant ID, sent as the `X-Scope-OrgID` header. Required when Tempo runs
# with multitenancy enabled; omit for a single-tenant instance.
#TEMPO_ORG_ID=

# Optional: accept self-signed / invalid TLS certificates (set to 1 or true)
#TEMPO_INSECURE=0

# Optional: address to bind the streamable-HTTP MCP server (default 127.0.0.1:8092).
# The MCP endpoint is served at http://<bind>/mcp
#TEMPO_BIND=127.0.0.1:8092

# Optional: comma-separated allowed Host header values. Defaults to loopback only
# (DNS-rebinding protection). Set this when serving on a hostname.
#TEMPO_ALLOWED_HOSTS=tempo-mcp.example.ts.net,localhost,127.0.0.1
