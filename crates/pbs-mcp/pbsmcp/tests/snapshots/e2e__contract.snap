    "instructions": "Read-only access to a Proxmox Backup Server. Use these tools to inspect datastores, backup snapshots, and task history to check backup status.",
    "protocolVersion": "2025-06-18",
    "serverInfo": {
      "name": "pbsmcp",
      "version": "[version]"
    }
  },
  "prompts": [
    {
      "arguments": [
        {
          "description": "Specific datastore to report on. Omit to check all configured datastores.",
          "name": "datastore",
          "required": false
        }
      ],
      "description": "Assess backup health and datastore status: capacity, GC completion, and recent task failures.",
      "name": "backup_health_report"
    },
    {
      "arguments": [
        {
          "description": "Datastore to audit (required).",
          "name": "datastore",
          "required": true
        },
        {
          "description": "Specific backup group to audit (e.g., `vm/100`). Omit to audit all groups in the datastore.",
