      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "end_time": {
            "default": null,
            "description": "Optional end time in ISO 8601 format.",
            "type": [
              "string",
