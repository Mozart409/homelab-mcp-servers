    "instructions": "Home Assistant MCP server for controlling your smart home. Provides tools to query entities, call services, set states, inspect calendars, render templates, and check configuration.",
    "protocolVersion": "2025-06-18",
    "serverInfo": {
      "name": "hamcp",
      "version": "[version]"
    }
  },
  "prompts": [
    {
      "arguments": [
        {
          "description": "Restrict the survey to one domain, e.g. `automation`, `light`, `sensor`.\nOmit to survey the whole installation.",
          "name": "domain",
          "required": false
        }
      ],
      "description": "Read-only survey of a Home Assistant installation: unavailable entities, automations that never fire, and orphaned leftovers.",
      "name": "automation_audit"
    },
    {
      "arguments": [
        {
          "description": "Entity to diagnose, e.g. `sensor.living_room_temperature`.",
          "name": "entity_id",
          "required": true
        },
        {
          "description": "How many hours of history to review (default: 24).\n\nA string, not a number: MCP prompt arguments are always strings on the\nwire (`{[name]: string}`), so a numeric type here would reject every\nspec-compliant client's `\"48\"`. A value that is not a positive whole\nnumber falls back to the default.",
          "name": "hours",
          "required": false
        }
      ],
      "description": "Diagnose one Home Assistant entity from its current state and history: healthy, stuck, flapping, or unavailable.",
      "name": "entity_diagnostic"
    }
  ],
  "rendered_prompts": {
    "automation_audit/full": {
      "messages": [
        {
          "content": {
            "text": "Audit the `<domain>` domain and tell me what has quietly stopped working.\n\nWork in this order:\n1. Call `get_config` for the version and basic setup, then `check_config` to confirm the configuration itself is valid. A broken config explains failures that would otherwise look like unrelated dead entities, so establish this first.\n2. Call `get_states` to enumerate entities in scope.\n3. Pick the entities that look wrong and call `get_history` on a sample. Use `render_template` when a Jinja expression answers a question more directly than enumerating states would.\n\nSurface specifically:\n- Entities in `unavailable` or `unknown` state, and how long they have been so. Group them by integration — several dead entities from one integration is one fault, not several.\n- Automations that appear never to have triggered.\n- Duplicate or orphaned entities left behind by integrations that were removed.\n\nFinish with recommendations the operator can act on. This audit is read-only: do not call `set_state` or `call_service`, and present every corrective action as something for a human to approve rather than a step you take.",
            "type": "text"
          },
          "role": "user"
        }
      ]
    },
    "automation_audit/minimal": {
      "messages": [
        {
          "content": {
            "text": "Audit the whole installation and tell me what has quietly stopped working.\n\nWork in this order:\n1. Call `get_config` for the version and basic setup, then `check_config` to confirm the configuration itself is valid. A broken config explains failures that would otherwise look like unrelated dead entities, so establish this first.\n2. Call `get_states` to enumerate entities in scope.\n3. Pick the entities that look wrong and call `get_history` on a sample. Use `render_template` when a Jinja expression answers a question more directly than enumerating states would.\n\nSurface specifically:\n- Entities in `unavailable` or `unknown` state, and how long they have been so. Group them by integration — several dead entities from one integration is one fault, not several.\n- Automations that appear never to have triggered.\n- Duplicate or orphaned entities left behind by integrations that were removed.\n\nFinish with recommendations the operator can act on. This audit is read-only: do not call `set_state` or `call_service`, and present every corrective action as something for a human to approve rather than a step you take.",
            "type": "text"
          },
          "role": "user"
        }
      ]
    },
    "entity_diagnostic/full": {
      "messages": [
        {
          "content": {
            "text": "Diagnose the health of the Home Assistant entity `<entity_id>` over the last 24 hours.\n\nWork in this order:\n1. Call `get_entity` for `<entity_id>`. Report its current state verbatim and its `last_changed` timestamp. If the entity does not exist, stop and say so — do not guess at a similarly named one.\n2. Call `get_history` for the same entity over 24 hours. The history is the evidence; the current state alone cannot distinguish the cases below.\n3. Classify what you see into exactly one of:\n- **Healthy** — the value moves as the device plausibly should.\n- **Unavailable / unknown** — state is `unavailable` or `unknown`. This almost always means the integration or device dropped off, not that the reading is genuinely absent. Say how long it has been in that state.\n- **Stuck** — the value has not changed across the whole window although this kind of device should vary. Critically, a stuck sensor and a genuinely steady one look identical if you only read the current state, which is why step 2 is not optional.\n- **Flapping** — changing far more often than the device plausibly could.\n\nReport the actual state and timestamps you observed, not a summary judgement. If the history is too short or too sparse to separate 'steady' from 'stuck', say that plainly instead of picking one.\n\nThis is a read-only diagnosis. Do not call `set_state` or `call_service`. If a fix is warranted, describe it as a recommendation for the operator to approve.",
            "type": "text"
          },
          "role": "user"
        }
      ]
    },
    "entity_diagnostic/minimal": {
      "messages": [
        {
          "content": {
            "text": "Diagnose the health of the Home Assistant entity `<entity_id>` over the last 24 hours.\n\nWork in this order:\n1. Call `get_entity` for `<entity_id>`. Report its current state verbatim and its `last_changed` timestamp. If the entity does not exist, stop and say so — do not guess at a similarly named one.\n2. Call `get_history` for the same entity over 24 hours. The history is the evidence; the current state alone cannot distinguish the cases below.\n3. Classify what you see into exactly one of:\n- **Healthy** — the value moves as the device plausibly should.\n- **Unavailable / unknown** — state is `unavailable` or `unknown`. This almost always means the integration or device dropped off, not that the reading is genuinely absent. Say how long it has been in that state.\n- **Stuck** — the value has not changed across the whole window although this kind of device should vary. Critically, a stuck sensor and a genuinely steady one look identical if you only read the current state, which is why step 2 is not optional.\n- **Flapping** — changing far more often than the device plausibly could.\n\nReport the actual state and timestamps you observed, not a summary judgement. If the history is too short or too sparse to separate 'steady' from 'stuck', say that plainly instead of picking one.\n\nThis is a read-only diagnosis. Do not call `set_state` or `call_service`. If a fix is warranted, describe it as a recommendation for the operator to approve.",
            "type": "text"
          },
          "role": "user"
        }
      ]
    }
  },
  "resources": [
    {
      "description": "README for homeassistant-mcp: entity/service usage, and the deliberate exception that makes this the one server with mutating tools.",
      "mimeType": "text/markdown",
      "name": "Home Assistant MCP operator guide",
      "uri": "doc://hamcp/guide"
    }
  ],
  "tools": [
    {
      "description": "Call a Home Assistant service to control devices. Examples: domain='light', service='turn_on', entity_id='light.living_room'",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "domain": {
            "description": "The service domain (e.g., `light`, `switch`, `climate`).",
            "type": "string"
          },
          "entity_id": {
            "default": null,
            "description": "Optional entity ID to target (e.g., `light.living_room`).",
            "type": [
              "string",
              "null"
            ]
          },
          "service": {
            "description": "The service name (e.g., `turn_on`, `turn_off`, `set_temperature`).",
            "type": "string"
          },
          "service_data": {
            "additionalProperties": true,
            "default": null,
            "description": "Optional service data parameters (e.g., `{\"brightness\": 255}`).",
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "domain",
          "service"
        ],
        "type": "object"
      },
      "name": "call_service"
    },
    {
      "description": "Validate the Home Assistant configuration.yaml file",
